    "types:local": "node scripts/gen-types.mjs --local && biome format --write types/supabase.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {

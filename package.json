{
  "name": "template-alunos",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "migrate": "node scripts/migrate.mjs",
    "worker": "node scripts/worker.mjs",
    "semear": "node scripts/semear.mjs",
    "gerar-chave": "node scripts/gerar-chave.mjs",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint .",

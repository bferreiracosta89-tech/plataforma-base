# As QUATRO variáveis do app. Todas obrigatórias — não existe opcional.
#
# NA SUA MÁQUINA: copie este arquivo pra `.env.local` e preencha.
# NO EASYPANEL:   cole essas quatro na aba "Environment" e clique em Deploy.
#                 O resto (tabelas do banco, agentes, automações) o app faz
#                 sozinho quando liga.
#
# Chave de IA e chave de email NÃO ficam aqui — você cadastra pelas telas do
# app depois que ele estiver no ar (menu Plataforma → Configurações).
#
# Passo a passo com telas: docs/04-publicando/02-configurando-vps-easypanel.md


# supabase.com → seu projeto → Settings → API → Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# supabase.com → seu projeto → Settings → API → chave "anon public"
SUPABASE_ANON_KEY=

# supabase.com → seu projeto → Settings → Database → Connection string → URI
# Copie inteiro e troque [YOUR-PASSWORD] pela senha do banco que você criou.
DATABASE_URL=postgresql://postgres:SUA-SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# O cadeado que tranca as chaves de API cadastradas pelas telas.
# Gere a sua com:  npm run gerar-chave
#
# ⚠️ PERDER ESSA CHAVE = RECADASTRAR TODAS AS CHAVES DE API. Guarde junto com
#    suas senhas, e não troque depois que o app estiver rodando.
#
# No EasyPanel dá pra deixar em branco no primeiro deploy: o app gera uma
# temporária e imprime no registro (log) pra você colar no painel.
ENCRYPTION_KEY=
